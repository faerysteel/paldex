diff --git a/UnrealMappingsDumper/app.cpp b/UnrealMappingsDumper/app.cpp
index 34b9cf0..9aec494 100644
--- a/UnrealMappingsDumper/app.cpp
+++ b/UnrealMappingsDumper/app.cpp
@@ -63,6 +63,14 @@ static bool InitEngine(GameInstance& Game)
 	}
 	
 
+	// Palworld is UE 5.1, which still has the 16-byte FFieldVariant (bIsUObject
+	// present) and so FProperty is 0x78, not the 0x70 of the 5.3 preset.
+	if (Game.GamePath.filename() == "Palworld-Win64-Shipping.exe")
+	{
+		wprintf(L"Palworld: using UE5.1 (base 0x78) layout...\n");
+		return IUnrealVersion::InitTypes<UnrealVersionBase>();
+	}
+
 	if(Game.Version >= 5.0)
 	{
 		wprintf(L"Use UE5 UnrealVersion... \n");
diff --git a/UnrealMappingsDumper/dllmain.cpp b/UnrealMappingsDumper/dllmain.cpp
index 2d3fcc2..c1b6d1f 100644
--- a/UnrealMappingsDumper/dllmain.cpp
+++ b/UnrealMappingsDumper/dllmain.cpp
@@ -10,8 +10,15 @@ void WINAPI Main(HMODULE Module)
 	if constexpr (OpenConsole)
 	{
 		AllocConsole();
-		FILE* f;
-		freopen_s(&f, "CONOUT$", "w", stdout);
+		FILE* f = nullptr;
+		if (freopen_s(&f, "C:\\dumper\\dumper.log", "w", stdout) != 0 || !f)
+		{
+			wchar_t tmpdir[MAX_PATH]{};
+			GetTempPathW(MAX_PATH, tmpdir);
+			std::wstring alt = std::wstring(tmpdir) + L"dumper.log";
+			_wfreopen_s(&f, alt.c_str(), L"w", stdout);
+		}
+		if (f) setvbuf(stdout, NULL, _IONBF, 0);
 	}
 
 	UE_LOG("Unreal Mappings Dumper injected, waiting for engine initialization...");
